DISCORD_TOKEN=your-bot-token-here
# Optional: your test server ID for instant slash-command sync while developing
GUILD_ID=
# Optional: where the SQLite database lives (default: verification.db)
DB_PATH=verification.db
# Optional: set to true to log the TEXT of deleted/edited messages.
# Requires "Message Content Intent" switched on in the Discord Developer Portal first.
MESSAGE_CONTENT=false
# Optional: extra checkout hosts for the shop, if you set up a custom domain for Stripe Payment Links
# STRIPE_EXTRA_HOSTS=pay.example.com
# Optional: turns on purchase DMs (Invoice ID + "open a ticket"). Get it from Stripe: Developers -> Webhooks -> your endpoint -> Signing secret.
# Test and live endpoints have different secrets. Put both in one value separated by a comma.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Ticket transcripts need message text, so set MESSAGE_CONTENT=true (and enable Message Content Intent in the Developer Portal).
# Embed look: "black" (default, every embed is a clean black card) or "color" for status colours (green/amber/red)
# EMBED_THEME=black
# The bot's status cycles through these, separated by commas (default below). STATUS_SECONDS is how often it changes (min 15).
# BOT_STATUSES=.gg/xzxx,bypassing the check
# STATUS_SECONDS=30
# Big files: limits per file / per server in MB (default 200 / 1000), and where they are saved (default: a "files" folder next to the database)
# MAX_FILE_MB=200
# FILE_STORAGE_MB=1000
# FILES_DIR=/data/files
# Optional: your own public address for download links (default: the Railway domain)
# PUBLIC_URL=https://files.example.com
# Keep the bot private: it leaves any server not listed here (comma-separated server IDs). Or just run /serverlock on in your server.
# ALLOWED_GUILD_IDS=123456789012345678
